/Title (class primepalindrome{    static boolean isPrime\(int n\){ // method to check prime number   if\(n <= 1\)     return false; if\(n<= 3\)     return true; if\(n %2 == 0 || n%3 == 0\)     return false; for \(int i = 5 ;\(long\) i * i<= n;i +=6\){     if\(n % 2 == 0 || n %\(i +2\) == 0\)         return false; } return true;     })
